# Copy to a private path and choose a new ID for each run. PREFIX must be at
# most 8 lowercase letters and digits. Only westus2 and zone 1 are accepted.
RUN_ID=replace-with-unique-run-id
PREFIX=replaceme
SUBSCRIPTION=00000000-0000-0000-0000-000000000000
LOCATION=westus2
ZONE=1
DEADLINE=REPLACE_WITH_UTC_DEADLINE
OPERATOR_CIDR=192.0.2.1/32
IMAGE=/CommunityGalleries/ClusterAPI-f72ceb4f-5159-4c26-a0fe-2ea738f0d019/Images/capi-ubun2-2404/Versions/1.37.0
CA_IMAGE=localhost/cluster-autoscaler-azure:candidate-replace-with-commit
WORKLOAD_IMAGE=busybox@sha256:b7f3d86d6e84fc17718c48bcde1450807faa2d56704205c697b4bd5df7b9e29f

# Every private path must be outside the repository. The private directory
# must have RUN_ID as its last path component.
PRIVATE_DIR=/absolute/private/path/replace-with-unique-run-id
REPORT_DIR=/absolute/report/path/replace-with-unique-run-id
# Pin a separate Calico manifest with CALICO_IPV4POOL_VXLAN=Always and
# CALICO_IPV4POOL_IPIP=Never. CrossSubnet leaves same-subnet worker Pod traffic
# unrouted on Azure. Set the digest for that exact file; the script does not edit it.
CALICO_MANIFEST=/absolute/path/to/pinned-calico-vxlan-always.yaml
CALICO_SHA256=replace-with-sha256-of-calico-manifest
CCM_CHART=/absolute/path/to/cloud-provider-azure-1.36.0.tgz
DISK_CHART=/absolute/path/to/azuredisk-csi-driver-1.36.0.tgz
# Name prefix of the inbound NSG rules and resources that an organization
# policy adds to run-owned groups. Leave it empty to accept none.
POLICY_NAME_PREFIX=

# Run A: 14 USD, stop new cases after eight hours.
# Run B: 16 USD, set PAST_RUN_COST_USD to A's recorded estimate,
# stop new cases after seven hours.
RUN_BUDGET_USD=14
PAST_RUN_COST_USD=0
CLEANUP_RESERVE_USD=3
STOP_NEW_HOURS=8
DEMAND_CPU=1200m
LARGE_CPU=600m
VNET_CIDR=10.144.0.0/16
CP_CIDR=10.144.0.0/24
WORKER_CIDR=10.144.1.0/24
BASTION_CIDR=10.144.2.0/26
POD_CIDR=192.168.0.0/16
SSH_PORT=2222
API_PORT=16443
